---
import "~/styles/tokens.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · WHISKER</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="mx-auto max-w-3xl px-6 py-16">
      <slot />
    </main>

    <footer class="mx-auto max-w-3xl border-t border-rule px-6 py-8 text-sm text-muted">
      <p>
        Données de performance :
        <a class="underline" href="https://oracleselixir.com/tools/downloads">Oracle&rsquo;s Elixir</a>.
        Contrats, âges et rosters :
        <a class="underline" href="https://lol.fandom.com">Leaguepedia / Fandom</a>.
      </p>
      <p class="mt-2">WHISKER n&rsquo;est pas affilié à Riot Games.</p>
    </footer>
  </body>
</html>

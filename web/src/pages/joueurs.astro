---
import Base from "~/layouts/Base.astro";
import PlayerExplorer from "~/components/PlayerExplorer";
import NoData from "~/components/NoData.astro";
import { hasAllData, readData } from "~/lib/data";

const ready = hasAllData();
const players = ready ? readData("players").players : [];
const meta = ready ? readData("meta") : null;
---

<Base
  title="Joueurs"
  description="Classement des joueurs LEC et LFL par indice de valeur, avec intervalles et taille d'échantillon."
  wide
>
  <h1 class="font-display text-2xl uppercase tracking-tight">Joueurs</h1>
  <p class="mt-3 max-w-prose text-muted">
    Les mêmes données, en tableau ou en graphique. Le seuil par défaut de 25 games écarte les
    échantillons trop maigres pour être classés ; abaissez-le pour les faire réapparaître,
    signalés par ⚑.
  </p>

  <div class="mt-8">
    {
      ready ? (
        <PlayerExplorer client:load players={players} confidenceLevel={meta!.confidenceLevel} />
      ) : (
        <NoData what="Le classement des joueurs" />
      )
    }
  </div>
</Base>

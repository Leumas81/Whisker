---
const links = [
  { href: "/joueurs", label: "Joueurs" },
  { href: "/traduction", label: "Traduction" },
  { href: "/vieillissement", label: "Vieillissement" },
  { href: "/methode", label: "Méthode" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="border-b border-rule">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-baseline gap-x-6 gap-y-2 px-6 py-4"
       aria-label="Navigation principale">
    <a href="/" class="font-display text-lg uppercase tracking-tight">Whisker</a>
    <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href ? "page" : undefined}
              class:list={[
                "hover:underline",
                path === link.href ? "font-medium underline underline-offset-4" : "text-muted",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
